<fieldset class="box tabular settings">
  <legend><%= l(:label_general_issue_todo_lists_settings) %></legend>
  <% %w(show_in_issue_sidebar show_in_issue_edit).each do |setting_key| %>
    <p>
      <%= label_tag "settings_#{setting_key}", l("label_#{setting_key}") %>
      <%= check_box_tag "settings[#{setting_key}]", 1, RedmineIssueTodoLists::Settings.enabled?(setting_key, @settings) %>
    </p>
  <% end %>
</fieldset>
