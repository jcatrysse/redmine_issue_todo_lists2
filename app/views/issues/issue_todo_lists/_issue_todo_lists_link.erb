<% if RedmineIssueTodoLists::Settings.enabled?('show_in_issue_sidebar') %>
  <% content_for :sidebar do %>
    <% todo_lists = IssueTodoList.visible.where(project_id: @project.self_and_ancestors.ids).includes(:project).order('project_id', 'title').to_a %>
    <% if todo_lists.any? -%>
      <% item_ids = IssueTodoListItem.where(issue_todo_list_id: todo_lists.map(&:id), issue_id: @issue.id).pluck(:issue_todo_list_id, :id).to_h %>
      <h3><%= l(:issue_todo_lists_title) %></h3>
      <ul>
        <% todo_lists.each do |todo_list| %>
          <li>
            <%= link_to "#{todo_list.project.name}: #{todo_list.title}", project_issue_todo_list_path(todo_list.project, todo_list) %>
            <% if item_ids[todo_list.id] %>
              <% if User.current.allowed_to?(:remove_issue_todo_list_items, todo_list.project) %>
                <%= link_to RedmineIssueTodoLists::Icon.call(self, 'link-break', l(:issue_todo_lists_remove_item), icon_only: true),
                            project_issue_todo_list_item_path(todo_list.project, todo_list, item_ids[todo_list.id], :back_url => issue_path(@issue)),
                            :method => :delete,
                            :data => {:confirm => l(:text_are_you_sure)},
                            :class => 'icon-only icon-link-break',
                            :title => l(:issue_todo_lists_remove_item) %>
              <% else %>
                <span class="icon-only icon-checked" title="<%= l(:issue_todo_lists_listed) %>"><%= RedmineIssueTodoLists::Icon.call(self, 'checked', l(:issue_todo_lists_listed), icon_only: true) %></span>
              <% end %>
            <% elsif User.current.allowed_to?(:add_issue_todo_list_items, todo_list.project) && !(todo_list.remove_closed_issues && @issue.closed?) %>
              <%= link_to RedmineIssueTodoLists::Icon.call(self, 'add', l(:issue_todo_lists_add_to_list), icon_only: true),
                          bulk_allocate_issues_project_issue_todo_list_path(todo_list.project, todo_list, :issue_ids => [@issue.id], :back_url => issue_path(@issue)),
                          :method => :post,
                          :class => 'icon-only icon-add',
                          :title => l(:issue_todo_lists_add_to_list) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
<% end %>
