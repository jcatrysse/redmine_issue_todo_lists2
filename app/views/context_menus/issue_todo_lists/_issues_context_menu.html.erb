<% if todo_lists.any? -%>
  <li class="folder">
    <a href="#" class="submenu"><%= l(:issue_todo_lists_title) %></a>
    <% if RedmineIssueTodoLists::Icon.sprites? -%>
      <span class="icon-only"><%= sprite_icon('angle-right', rtl: true) %></span>
    <% end -%>
    <ul>
      <% todo_lists.each do |todo_list| -%>
        <% listed = listed_issue_ids[todo_list.id] || [] %>
        <% list_name = "#{todo_list.project.name} - #{todo_list.title}" %>
        <% if @issue && listed.include?(@issue.id) %>
          <% icon = 'del' %>
          <% list_count = -1 %>
          <% li_title = l(:issue_todo_lists_cm_unlist_item, :list => list_name) %>
        <% elsif @issue %>
          <% icon = 'add' %>
          <% list_count = 1 %>
          <% li_title = l(:issue_todo_lists_cm_add_item, :list => list_name) %>
        <% elsif (@issue_ids - listed).empty? %>
          <% icon = 'del' %>
          <% list_count = -(@issue_ids.count) %>
          <% li_title = l(:issue_todo_lists_cm_unlist_all, :list => list_name) %>
        <% elsif (@issue_ids & listed).empty? %>
          <% icon = 'add' %>
          <% list_count = @issue_ids.count %>
          <% li_title = l(:issue_todo_lists_cm_add_all, :list => list_name) %>
        <% else %>
          <% icon = 'warning' %>
          <% list_count = (@issue_ids - listed).count %>
          <% li_title = l(:issue_todo_lists_cm_add_some, :list => list_name, :count => list_count, :total => @issue_ids.count) %>
        <% end %>
        <li title="<%= li_title %>">
          <%= link_to RedmineIssueTodoLists::Icon.call(self, icon, todo_list.title), # Use link_to as context_menu_link's selected disables href
                      bulk_allocate_issues_project_issue_todo_list_path(todo_list.project, todo_list, :issue_ids => @issue_ids, :back_url => @back, :list_count => list_count),
                      :method => :post, :class => "icon icon-#{icon}" %>
        </li>
      <% end %>
    </ul>
  </li>
<% end %>
