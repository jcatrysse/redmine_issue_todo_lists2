<% title = "#{l(:issue_todo_lists_title_singular)}: #{@todo_list.title}" %>
<% html_title(title) %>
<% can_order = User.current.allowed_to?(:order_issue_todo_list_items, @project) %>
<% can_add = User.current.allowed_to?(:add_issue_todo_list_items, @project) %>
<% content_for :header_tags do %>
  <%= stylesheet_link_tag "issue-todo-list.css", :plugin => :redmine_issue_todo_lists2, :media => 'all' %>
  <%= javascript_include_tag 'issue-todo-list.js', :plugin => :redmine_issue_todo_lists2 %>
<% end %>
<div class="contextual">
  <% if User.current.allowed_to?(:edit_issue_todo_lists, @project) %>
    <%= link_to RedmineIssueTodoLists::Icon.call(self, 'edit', l(:button_edit)), edit_project_issue_todo_list_path(@project, @todo_list), :accesskey => accesskey(:edit), :class => 'icon icon-edit' %>
  <% end %>
  <% if User.current.allowed_to?(:delete_issue_todo_lists, @project) %>
    <%= link_to RedmineIssueTodoLists::Icon.call(self, 'del', l(:button_delete)), project_issue_todo_list_path(@project, @todo_list), method: :delete, data: { confirm: l('text_are_you_sure') }, class: 'icon icon-del' %>
  <% end %>
</div>
<h2><%= title %></h2>
<div class="splitcontentleft">
  <div class="wiki"><%= textilizable(@todo_list, :description) %></div>
</div>
<div class="splitcontentright">
  <div class="box" id="show-right-box">
    <%= render :partial => 'issue_todo_lists/show/right_box' %>
  </div>
</div>
<div class="autoscroll">
  <%= form_tag({}, :data => {:cm_url => issues_context_menu_path}) do -%>
  <table id="issue-todo-list-table" class="list <%= 'sortable' if can_order %>"
         data-reorder-url="<%= update_item_order_project_issue_todo_list_path(@project, @todo_list) %>"
         data-reorder-error="<%= l(:issue_todo_lists_order_error) %>">
    <thead>
    <tr>
      <th class="checkbox hide-when-print">
        <%= check_box_tag 'check_all', '', false, :class => 'toggle-selection',
                          :title => "#{l(:button_check_all)}/#{l(:button_uncheck_all)}" %>
      </th>
      <th><%= l(:issue_todo_label_order) %></th>
      <% todo_list_issue_columns(@todo_list, @issue_query).each do |column| %>
        <th><%= column.caption %></th>
      <% end %>
      <th><%= l(:label_comment) %></th>
      <% if User.current.allowed_to?(:update_issue_todo_list_items, @project) %>
        <th class="buttons"></th>
      <% end %>
      <% if User.current.allowed_to?(:remove_issue_todo_list_items, @project) %>
        <th class="buttons"></th>
      <% end %>
    </tr>
    </thead>
    <tbody>
      <%= render :partial => 'items' %>
    </tbody>
  </table>
  <% end %>
  <%= context_menu %>
</div>
<% if User.current.allowed_to?(:update_issue_todo_list_items, @project) %>
  <div id="update_issue_todo_list_items_wrapper">
  </div>
<% end %>
<% if can_add %>
  <h3><%= l(:issue_todo_lists_add_issue) %></h3>
  <div  id="new_item_comment_box" class="box tabular">
    <%= form_for IssueTodoListItem.new, {
                                          :as => :item, :remote => true,
                                          :url => project_issue_todo_list_items_path(@project, @todo_list),
                                          :html => {:id => 'new-item-form'}
                                      } do |f| %>
      <div class="errors"></div>
      <p>
        <%= f.label :issue_id, l(:label_issue), :for => 'item_issue_id' %> #<%= f.text_field :issue_id, {size: 10, id: 'item_issue_id'} %>
      </p>
      <%= javascript_tag "observeAutocompleteField('item_issue_id', '#{escape_javascript auto_complete_issues_path(:project_id => @project, :scope => (Setting.cross_project_issue_relations? ? 'all' : nil))}')" %>
      <p>
        <%= f.label :comment, l(:label_comment), :for => 'new_item_comment' %> <%= f.text_area :comment, {rows: 8, id: 'new_item_comment', class: 'wiki-edit' } %>
      </p>
      <p>
        <%= submit_tag l(:button_save) %>
        <%= link_to_function l(:button_cancel), "$('#new_item_comment').removeData('changed'); $('#new-item-form').get(0).reset()" %>
      </p>
    <% end %>
  </div>
  <%= wikitoolbar_for 'new_item_comment', preview_text_path %>
<% end %>
<% other_formats_links do |f| %>
  <%= f.link_to 'CSV', :url => {} %>
<% end %>
