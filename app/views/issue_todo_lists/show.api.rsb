api.array :todo_list_items do
  @todo_list_items.each do |todo_list_item|
    api.todo_list_items do
      api.id todo_list_item.id
      api.position todo_list_item.position
      if (issue = todo_list_item.issue)
        api.issue do
          api.id issue.id
          api.subject issue.subject
          api.project(:id => issue.project.id, :project_name => issue.project.name)
          api.tracker(:id => issue.tracker.id, :name => issue.tracker.name)
          api.status(:id => issue.status.id, :name => issue.status.name)
          api.priority(:id => issue.priority.id, :name => issue.priority.name)
          api.start_date issue.start_date
          api.due_date issue.due_date
          api.total_estimated_hours issue.total_estimated_hours
        end
      end
      api.comment todo_list_item.comment
      if todo_list_item.data.present?
        api.array :data do
          todo_list_item.data.each do |entry|
            api.entry(:field => entry[:field] || entry['field'], :value => entry[:value] || entry['value'])
          end
        end
      end
    end
  end
end
