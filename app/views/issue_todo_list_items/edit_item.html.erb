<% if User.current.allowed_to?(:update_issue_todo_list_items, @project) %>
  <div id="edit_item_comment_box" class="box tabular">
    <%= labelled_form_for [@project, @item], :as => :item, :remote => true, :url => project_issue_todo_list_item_path(@project, @todo_list, @item), :method => :put, :html => {:id => 'edit-item-form'} do |f| %>
      <div class="errors"></div>
      <p>
        <%= label_tag 'edit_item_comment', l(:label_comment) %>
        <%= f.text_area :comment, {rows: 8, id: 'edit_item_comment', class: 'wiki-edit', no_label: true} %>
      </p>
      <% if @item.issue.nil? %>
        <% @todo_list.included_fields.each_with_index do |field_name, index| %>
          <% column = @issue_query.available_columns.find { |c| c.name.to_s == field_name.to_s } %>
          <% next unless column %>
          <% input_id = "edit_item_data_#{index}" %>
          <% value = @item.data_value(column.name) %>
          <p>
            <%= label_tag input_id, column.caption %>
            <%= hidden_field_tag 'item[data][][field]', column.name, :id => nil %>
            <% if column.name.to_s.match?(/date(_|\b)/) %>
              <%= date_field_tag 'item[data][][value]', value, :id => input_id %>
            <% else %>
              <%= text_field_tag 'item[data][][value]', value, :id => input_id %>
            <% end %>
          </p>
        <% end %>
      <% end %>
      <%= submit_tag l(:button_save), :onclick => "$('#edit_item_comment').removeData('changed');" %>
      <%= link_to_function l(:button_cancel), "$('#edit_item_comment').removeData('changed'); $('#edit_item_comment_box').hide()" %>
    <% end %>
    <%= wikitoolbar_for 'edit_item_comment', preview_text_path %>
  </div>
<% end %>
